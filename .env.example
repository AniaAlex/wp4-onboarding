# Django
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# Database — SQLite on the persisted /app/data volume.
# Note: 4 slashes for an absolute Unix path (sqlite:////absolute/path).
# To switch to Postgres, replace with:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////app/data/db.sqlite3

# Demo seed credentials (used by `make seed`)
DEMO_OPERATOR_EMAIL=operator@wp4trust.local
DEMO_OPERATOR_PASSWORD=demo-pass-12345

# Django super-admin (used by `make createsuperuser`)
DJANGO_SUPERUSER_EMAIL=admin@wp4trust.local
DJANGO_SUPERUSER_PASSWORD=change-me-now

# Host port (default 8001 to avoid clashing with ms-registry's 8000)
WEB_PORT=8001
